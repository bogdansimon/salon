#!/usr/bin/env bash
# Blocks commits that contain secrets. Installed by scripts/install-hooks.sh.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks). Commit blocked." >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml
