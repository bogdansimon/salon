// Copy to Local.xcconfig (gitignored) to sign with your own Apple ID team.
// Signing with a stable identity keeps Keychain access and Login Items approval
// across rebuilds; ad-hoc builds may ask again after each rebuild.
//
//   cp Local.xcconfig.example Local.xcconfig
//
// Find your team id in Xcode › Settings › Accounts, or developer.apple.com › Membership.

DEVELOPMENT_TEAM = ABCDE12345
CODE_SIGN_IDENTITY = Apple Development
